# Copy to .env and keep it out of source control.
# Defaults: PORT=4317, PI_DATA_DIR=<project>/.pi-research
PORT=4317
# PI_DATA_DIR=/absolute/path/to/pi-research-data

# Leave blank until a real provider/model has been selected.
PI_PROVIDER=
PI_MODEL=
PI_API_KEY=
# Live acceptance is opt-in and reads process environment, not this file.
# Set PI_LIVE_TEST=1 in your shell only when running npm run test:live.

# Literature credentials: used ONLY by the control service, never forwarded to Pi Workers.
# New sources must also be enabled explicitly in the workbench per project.
# A configured key does not enable a source or guarantee provider access/free usage.
OPENALEX_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
