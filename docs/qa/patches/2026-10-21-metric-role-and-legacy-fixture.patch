+test('metric source keeps exact schema, old pin, parent and active-root bounds',()=>{const s=setup();try{const f=claimsFixture(s),contract=metricsContract(f),input={title:'UNIT bounds',contract};for(const bad of [{...input,contract:{...contract,metrics:{x:{unit:'x',direction:'min'}}}},{...input,contract:{...contract,metricsSource:'other'}},{...input,contract:{...contract,unexpected:true}}])assert.throws(()=>validateSchema(INPUT_SCHEMAS.experiment_plan_submit,bad),{code:'INVALID_INPUT'});assert.throws(()=>f.op('experiment_plan_submit',input),{code:'BRIEF_NOT_CONFIRMED'});claimsReady(s,f);claimsConfirm(s,f);const before=s.app.store.list('session-action').length;assert.throws(()=>f.op('experiment_plan_submit',{...input,parentId:s.baseline.id}),{code:'METHOD_METRICS_SOURCE_DENIED'});const other=s.app.sessions.create(USER,s.project.id,{}, {role:'reviewer'});assert.equal(other.role,'reviewer');assert.throws(()=>s.app.experiments.resolvePreparationInput(USER,s.project.id,other.id,input),{code:'METHOD_METRICS_SOURCE_DENIED'});assert.equal(s.app.store.list('session-action').length,before);}finally{s.close();}const old=setup();try{const legacyBundleId='d18d2abe8151fa77dadb57d89e4b959169ceff1808f0285e5714a38bc6e71296';old.app.skills.configure(USER,old.project.id,{expectedVersion:0,revisionIds:[],builtinBundleId:legacyBundleId});const f=claimsFixture(old,{compile:false});assert.equal(old.app.store.get('session',f.actor.sessionId).skillBundleId,legacyBundleId);f.q.planningProfile='paired-plan-claims-v1';for(const measurement of f.q.planning.measurements)delete measurement.assessments;f.compiled=f.op('research_method_compile',{specification:f.specification},'claims-compile');assert.equal(f.compiled.compilerVersion,'method-contract-v5');claimsReady(old,f);claimsConfirm(old,f);const c=metricsContract(f);assert.throws(()=>f.op('experiment_plan_submit',{title:'UNIT old source',contract:c}),{code:'METHOD_METRICS_SOURCE_DENIED'});delete c.metricsSource;c.metrics={legacy_key:{unit:'legacy unit',direction:'min'}};assert.throws(()=>f.op('experiment_plan_submit',{title:'UNIT old explicit',contract:c}),{code:'APPROVAL_REQUIRED'});}finally{old.close();}});

 test('metric source rejects changed confirmed source, method or permission before effect without replacement approvals',()=>{for(const variant of ['source','method','permission']){const s=setup();try{const f=claimsFixture(s);claimsReady(s,f);claimsConfirm(s,f);const input={title:'UNIT changed metric binding',contract:metricsContract(f)},experiments=s.app.store.list('experiment').length;assert.throws(()=>f.op('experiment_plan_submit',input,'metric-stale'),{code:'APPROVAL_REQUIRED'});const a=s.app.store.list('session-action').at(-1),p=s.app.store.get('approval',a.approvalId);s.app.sessionPermissions.decide(USER,s.session.id,a.id,{expectedVersion:a.version,expectedApprovalVersion:p.version,approved:true});const count=s.app.store.list('approval').length;if(variant==='permission'){const row=s.app.store.get('session-permission',s.session.id);s.app.store.update('session-permission',row.id,row.version,{epoch:row.epoch+1});}else if(variant==='method'){const row=s.app.store.get('research-brief',f.brief.id);s.app.store.update('research-brief',row.id,row.version,{methodContract:{...row.methodContract,contractDigest:'0'.repeat(64)}});}else{const i=f.brief.sourceInputs[0],row=s.app.store.get('artifact',i.artifactId),path=s.app.store.paths.physical(row.path);chmodSync(path,0o600);writeFileSync(path,'UNIT changed source bytes');}assert.throws(()=>s.app.sessionPermissions.validate(a.policy,s.session.id,'experiment_plan_submit',input,a.id));assert.equal(s.app.store.list('approval').length,count);assert.equal(s.app.store.list('experiment').length,experiments);assert.equal(JSON.stringify(s.app.store.get('session-action',a.id).input),JSON.stringify(input));}finally{s.close();}}});
