 test('I wrong explicit metric keys, unit and direction reject before accurate approval',()=>{const s=setup();try{const f=claimsFixture(s,{compile:false});f.q.metrics={baselineRmse:'baseline_rmse',candidateRmse:'candidate_rmse',gain:'rmse_gain'};f.compiled=f.op('research_method_compile',{specification:f.specification},'claims-compile');claimsReady(s,f);claimsConfirm(s,f);const source=metricsContract(f);delete source.metricsSource;const expected={baseline_rmse:{unit:f.q.outcomeUnit,direction:'min'},candidate_rmse:{unit:f.q.outcomeUnit,direction:'min'},rmse_gain:{unit:f.q.outcomeUnit,direction:'max'}},actions=s.app.store.list('session-action').length,experiments=s.app.store.list('experiment').length;for(const variant of ['keys','unit','direction']){const metrics=structuredClone(expected);if(variant==='keys'){delete metrics.baseline_rmse;metrics.baselineRmse={unit:f.q.outcomeUnit,direction:'min'};}else if(variant==='unit')metrics.baseline_rmse.unit='wrong unit';else metrics.rmse_gain.direction='min';assert.throws(()=>f.op('experiment_plan_submit',{title:'UNIT invalid explicit '+variant,contract:{...source,metrics}}),{code:'METHOD_METRICS_BINDING_INVALID'});assert.equal(s.app.store.list('session-action').length,actions);assert.equal(s.app.store.list('experiment').length,experiments);}}finally{s.close();}});

